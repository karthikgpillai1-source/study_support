# Copy to .env and adjust.
# run-local.bat generates a random SECRET_KEY for you automatically.
# To roll one yourself:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 bytes (RFC 7518 s3.2); the app refuses to start in production with
# a short or placeholder value.
APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite now, PostgreSQL later (postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./study_intelligence.db

# Phase 1: API-based intelligence for CONTENT STRUCTURING only.
# Leave blank to use the deterministic structural analyser (fully offline).
# The Planner Engine never uses this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=60

# Optional Phase 2: self-hosted structured generation endpoint
# (llama.cpp / vLLM / Ollama, OpenAI-compatible /v1/chat/completions).
# The Planner Engine NEVER uses any LLM - planning is always deterministic.
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=qwen2.5-0.5b-instruct

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_MB=25
STORAGE_DIR=./storage
